---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
import '../styles/global.css';
import { calUrl } from '../config';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" width="30" height="30" role="img" aria-label="Marco Dütsch">
            <rect width="32" height="32" rx="9" fill="currentColor" />
            <path d="M10 22 L22 10" stroke="#fff" stroke-width="2.4" stroke-linecap="round" fill="none" />
            <circle cx="10" cy="22" r="3" fill="#fff" />
            <circle cx="16" cy="16" r="3" fill="#fff" />
            <circle cx="22" cy="10" r="3" fill="#fff" />
          </svg>
          <span class="brand-name">Marco Dütsch<i>.</i></span>
        </a>
        <nav class="nav" aria-label="Hauptnavigation">
          <a href="/leistungen/" aria-current={Astro.url.pathname === '/leistungen/' ? 'page' : undefined}>Leistungen</a>
          <a href="/projekte/" aria-current={Astro.url.pathname === '/projekte/' ? 'page' : undefined}>Projekte</a>
          <a href="/ueber-mich/" aria-current={Astro.url.pathname === '/ueber-mich/' ? 'page' : undefined}>Über mich</a>
          <a href="/kontakt/" aria-current={Astro.url.pathname === '/kontakt/' ? 'page' : undefined}>Kontakt</a>
          <a class="btn btn-primary" href={calUrl} target="_blank" rel="noopener">Erstgespräch</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p style="margin:0">© {new Date().getFullYear()} Marco Dütsch · Management-Beratung, Winterthur</p>
        <p style="margin:0 0 6px">
          <a href="/">Startseite</a> ·
          <a href="/leistungen/">Leistungen</a> ·
          <a href="/projekte/">Projekte</a> ·
          <a href="/ueber-mich/">Über mich</a> ·
          <a href="/kontakt/">Kontakt</a>
        </p>
        <p style="margin:0">
          <a href="/impressum/">Impressum</a> ·
          <a href="/datenschutz/">Datenschutz</a> ·
          <a href="mailto:marco@duetsch.net">marco@duetsch.net</a>
        </p>
      </div>
    </footer>
  </body>
</html>
